<h2>Caller overrides — merge, don't clobber</h2>

<p>
  Every helper takes arbitrary caller attributes and merges them <em>last</em>.
  <code>class</code>, <code>data-controller</code> and <code>data-action</code> union;
  everything else is last-wins; a trailing <code>!</code> forces replacement; an
  explicit <code>nil</code> deletes.
</p>

<section id="override-disclosure">
  <h3>disclosure with a caller controller, action and class</h3>
  <%= crosswire_disclosure "Shipping", id: "ov-disclosure",
        class: "card card--tight",
        data: { controller: "analytics", action: "click->analytics#track" } do %>
    <p>Both controllers are on the root element.</p>
  <% end %>
</section>

<section id="override-dialog">
  <h3>dialog with caller overrides</h3>
  <%= crosswire_dialog "Invite", id: "ov-dialog", trigger_label: "Invite…",
        class: "modal", data: { controller: "analytics", action: "keydown->analytics#key" } do %>
    <p>Body.</p>
  <% end %>
</section>

<section id="override-confirm">
  <h3>confirm with caller overrides</h3>
  <%= crosswire_confirm id: "ov-confirm", title: "Delete?", body: "Gone for good.",
        class: "modal modal--danger", data: { controller: "analytics" } %>
</section>

<section id="override-force">
  <h3>Force-replace with <code>!</code>, and delete with <code>nil</code></h3>
  <% d = cw_presenter(:disclosure, id: "ov-force") %>
  <div <%= cw_attrs(d.root_attrs, "data-controller!" => "only-mine", "id" => nil) %>>
    <code>data-controller</code> replaced outright; <code>id</code> removed.
  </div>
</section>

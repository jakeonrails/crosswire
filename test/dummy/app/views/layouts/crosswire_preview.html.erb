<!DOCTYPE html>
<html lang="en">
  <head>
    <title>crosswire preview</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# The previews are LIVE: the same importmap the host app uses is loaded here, so
        every component in Lookbook is a real, connected Stimulus controller. %>
    <%= javascript_importmap_tags %>
    <style>
      :root { color-scheme: light dark; }
      body { font: 16px/1.5 ui-sans-serif, system-ui, sans-serif; margin: 0; padding: 1.5rem; }
      button { font: inherit; padding: .35rem .75rem; }
      .cw-disclosure__panel[hidden], [hidden] { display: none; }
      .cw-dialog__panel::backdrop, .cw-confirm::backdrop { background: rgb(0 0 0 / .4); }
      .cw-disclosure__panel, .cw-dialog__body { padding: .5rem 0; }
      .is-open > .cw-disclosure__trigger { font-weight: 700; }
      .is-copied { outline: 2px solid green; }
      .fade { transition: opacity .2s ease; }
      .opacity-0 { opacity: 0; }
      .opacity-100 { opacity: 1; }
      .is-trapped { outline: 2px dashed currentColor; padding: .5rem; }
      .menu, .toast { border: 1px solid; border-radius: .375rem; padding: .75rem; max-width: 20rem; }
      .toolbar { display: flex; gap: .5rem; }
      .listbox { border: 1px solid; border-radius: .375rem; max-width: 16rem; }
      .listbox [role=option] { padding: .35rem .6rem; }
      .listbox [role=option]:focus { outline: 2px solid currentColor; outline-offset: -2px; }
      .cw-tabs__tablist { display: flex; gap: .25rem; border-bottom: 1px solid; margin-bottom: .5rem; }
      .cw-tabs__tab { border: none; background: none; padding: .35rem .75rem; }
      .cw-tabs__tab[aria-selected="true"] { font-weight: 700; border-bottom: 2px solid currentColor; }
    </style>
  </head>
  <body><%= yield %></body>
</html>

<% t = cw_presenter(:transition, leave: "fade", leave_from: "opacity-100", leave_to: "opacity-0") %>
<%= cw.dismiss_for label: "Dismiss" do |d| %>
  <div <%= cw_attrs(d.root_attrs, t.root_attrs, t.leave_on, class: "flash opacity-100") %>>
    Fades, then removes.
    <button <%= cw_attrs(d.trigger_attrs) %>>&times;</button>
  </div>
<% end %>

<%= crosswire_clipboard_for success_class: success_class.presence,
      success_duration: success_duration do |c| %>
  <div <%= cw_attrs(c.root_attrs) %>>
    <input <%= cw_attrs(c.source_attrs) %> value="https://example.com/invite/8f3a1c" readonly size="40">
    <button <%= cw_attrs(c.button_attrs) %>>Copy link</button>

    <%# MUST be in the initial markup, never injected at copy time — a live region
        added to the DOM at announcement time is not announced. %>
    <span class="sr-only" <%= cw_attrs(c.status_attrs) %>></span>
  </div>
<% end %>

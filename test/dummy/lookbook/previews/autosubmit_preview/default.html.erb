<form action="/lookbook/preview/autosubmit/default" method="get">
  <label>
    Search
    <%# A STABLE id plus data-turbo-permanent is what preserves focus and caret across
        the round-trip. That part lives in markup, not in the controller. %>
    <input <%= cw_attrs(crosswire_autosubmit_attrs(delay: delay, event: event),
                        type: "search", name: "q", id: "q") %> data-turbo-permanent>
  </label>
</form>

<style>
  .is-near-limit { color: #b35900; font-weight: bold; }
  .is-over-limit { color: #cf222e; font-weight: bold; }
</style>

<%= cw.char_count_for max: max, warn_at: warn_at,
      warn_class: "is-near-limit", over_class: "is-over-limit" do |c| %>
  <div <%= cw_attrs(c.root_attrs) %>>
    <label>
      Bio<br>
      <textarea <%= cw_attrs(c.input_attrs) %> rows="3" cols="40">Write a short bio.</textarea>
    </label>
    <p><%= tag.output(**c.output_attrs) %></p>
  </div>
<% end %>

<%= cw.dismiss_for remove: false, label: "Dismiss toast" do |d| %>
  <% t = cw_presenter(:timeout, delay: delay) %>
  <div <%= cw_attrs(d.root_attrs, t.root_attrs,
                    data: { action: "cw--timeout:elapsed->cw--dismiss#dismiss " \
                                    "mouseenter->cw--timeout#cancel " \
                                    "mouseleave->cw--timeout#restart" },
                    class: "toast", role: "status") %>>
    Saved. Auto-dismisses in <%= delay / 1000.0 %>s — hover to pause.
    <button <%= cw_attrs(d.trigger_attrs) %>>&times;</button>
  </div>
<% end %>

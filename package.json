{
  "name": "crosswire",
  "version": "0.1.0-alpha",
  "description": "Composable, accessible Hotwire primitives for Rails.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./app/assets/javascripts/crosswire/index.js",
    "./controllers/*": "./app/assets/javascripts/crosswire/controllers/*.js",
    "./morph": "./app/assets/javascripts/crosswire/morph.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.js",
    "test:all": "npm run test && npm run test:browser"
  },
  "peerDependencies": {
    "@hotwired/stimulus": ">=3.2"
  },
  "devDependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0.14",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "vitest": "^4.1.10"
  }
}
